# Copy this file to codexapp-fork.env and set a unique password.
CODEXAPP_PASSWORD=replace-with-a-long-random-password

# Keep these directories separate from the production codexapp service.
CODEXAPP_HOST_PORT=5910
CODEXAPP_ROOT_HOME=/opt/codexapp-fork/root-home
CODEXAPP_WORKSPACE_DIR=/opt/codexapp-fork/workspace
CODEXAPP_SSH_DIR=/root/.ssh
