#!/bin/sh
# 显式让单个命令使用宿主机 Xray；容器默认保持直连。
# Fastone 域名始终保留在 NO_PROXY，避免内部服务被误代理。
if [ "$#" -eq 0 ]; then
  echo "Usage: with-proxy <command> [args...]" >&2
  exit 64
fi

export HTTP_PROXY="socks5h://host.docker.internal:10808"
export HTTPS_PROXY="socks5h://host.docker.internal:10808"
export ALL_PROXY="socks5h://host.docker.internal:10808"
export NO_PROXY="localhost,127.0.0.1,::1,.fastonetech.com,.fastone.cc"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
export all_proxy="$ALL_PROXY"
export no_proxy="$NO_PROXY"

exec "$@"
